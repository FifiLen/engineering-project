{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hulajnogi/web",
        "exec",
        "next",
        "dev",
        "--port",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hulajnogi/api",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "simulator",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hulajnogi/simulator",
        "dev"
      ]
    },
    {
      "name": "api-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PORT=3005",
        "MQTT_ENABLED=false",
        "MQTT_CLIENT_ID=hulajnogi-api-preview",
        "PANEL_URL=http://localhost:3002",
        "node",
        "apps/api/dist/main.js"
      ],
      "port": 3005
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_API_URL=http://localhost:3005",
        "pnpm",
        "--filter",
        "@hulajnogi/mobile",
        "run",
        "web",
        "--port",
        "8082"
      ],
      "port": 8082
    },
    {
      "name": "api-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PORT=3001",
        "PANEL_URL=http://localhost:3002",
        "node",
        "apps/api/dist/main.js"
      ],
      "port": 3001
    },
    {
      "name": "mobile-web-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_API_URL=http://localhost:3001",
        "pnpm",
        "--filter",
        "@hulajnogi/mobile",
        "run",
        "web",
        "--port",
        "8082"
      ],
      "port": 8082
    },
    {
      "name": "web-start",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hulajnogi/web",
        "exec",
        "next",
        "start",
        "--port",
        "3006"
      ],
      "port": 3006
    },
    {
      "name": "api-history",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PORT=3005",
        "DATABASE_URL=postgres://hulajnogi:hulajnogi@localhost:5433/hulajnogi_history",
        "MQTT_ENABLED=false",
        "MQTT_CLIENT_ID=hulajnogi-api-history",
        "JOBS_ENABLED=true",
        "PANEL_URL=http://localhost:3007",
        "SITE_REVALIDATE_URL=",
        "node",
        "apps/api/dist/main.js"
      ],
      "port": 3005
    },
    {
      "name": "web-reports",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_API_URL=http://localhost:3005",
        "pnpm",
        "--filter",
        "@hulajnogi/web",
        "exec",
        "next",
        "dev",
        "--port",
        "3007"
      ],
      "port": 3007
    },
    {
      "name": "web-reports-start",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hulajnogi/web",
        "exec",
        "next",
        "start",
        "--port",
        "3009"
      ],
      "port": 3009,
      "url": "http://127.0.0.1:3009"
    }
  ]
}
