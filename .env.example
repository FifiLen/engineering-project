# Baza danych (Docker Compose z infra/). Gdy port 5432 jest zajęty, zmień oba wpisy, np. na 5433.
POSTGRES_PORT=5432
DATABASE_URL=postgres://hulajnogi:hulajnogi@localhost:5432/hulajnogi

# Broker MQTT. Backend łączy się ze stałym identyfikatorem i sesją trwałą (ADR 0033).
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=hulajnogi-api

# Magazyn plików SeaweedFS (API S3, ADR 0024, ADR 0057). Zdjęcia idą przez API, magazyn zostaje w sieci wewnętrznej.
# FILE_STORAGE: s3 (domyślnie) albo memory (pamięć procesu, tylko testy; w produkcji zatrzymuje start).
FILE_STORAGE=s3
S3_ENDPOINT=http://localhost:8333
# Region dla klienta S3 (SeaweedFS go nie sprawdza).
S3_REGION=us-east-1
# Klucze z infra/seaweedfs/s3.json; puste = wartości deweloperskie, w produkcji wymagane.
S3_ACCESS_KEY=hulajnogi
S3_SECRET_KEY=hulajnogi-dev-secret
S3_BUCKET=hulajnogi

# OSRM. Na macOS port 5000 zajmuje Odbiornik AirPlay: zmień oba wpisy, np. na 5001.
OSRM_PORT=5000
OSRM_URL=http://localhost:5000
# Drugi OSRM z profilem pieszym (trasa do hulajnogi, ADR 0048).
OSRM_FOOT_PORT=5002
OSRM_FOOT_URL=http://localhost:5002
# Wyszukiwanie miejsc „Dokąd jedziesz?” (ADR 0045); domyślnie publiczna instancja.
PHOTON_URL=https://photon.komoot.io

# Silnik dokumentów Gotenberg (ADR 0066): wydruki DOCX i HTML na PDF. Port tylko na 127.0.0.1;
# gdy 3010 jest zajęty, zmień oba wpisy.
GOTENBERG_PORT=3010
GOTENBERG_URL=http://localhost:3010
# Limit żądania do silnika (ms), razem z kolejką.
GOTENBERG_TIMEOUT_MS=30000
# DOCUMENT_RENDERER: gotenberg (domyślnie) albo fake (stały PDF, tylko testy; w produkcji zatrzymuje start).
DOCUMENT_RENDERER=gotenberg

# Backend
API_PORT=3001
# Sekrety logowania (ADR 0035). Puste = wartości deweloperskie; w produkcji wymagane.
# JWT_SECRET: co najmniej 32 znaki; TOTP_ENCRYPTION_KEY: openssl rand -base64 32
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
# Okno zbierania telemetrii przed zapisem (ms)
TELEMETRY_FLUSH_MS=1000
# Adresy panelu dopuszczone przez CORS w produkcji (po przecinku); w trybie deweloperskim każdy localhost
CORS_ORIGINS=

# Panel (Next.js): adres API widziany z przeglądarki
NEXT_PUBLIC_API_URL=http://localhost:3001
# Aplikacja mobilna: adres API widziany z telefonu (symulator iOS i web: localhost; telefon w sieci: adres komputera)
EXPO_PUBLIC_API_URL=http://localhost:3001
# Adres panelu w linkach zaproszeń operatorów (pnpm db:staff:create, API)
PANEL_URL=http://localhost:3000
# Adres strony w kodach QR hulajnóg: ${PUBLIC_SITE_URL}/h/0142 (ADR 0041)
PUBLIC_SITE_URL=http://localhost:3000
# Zadania w tle pg-boss (ADR 0037); false tylko do testów
JOBS_ENABLED=true
# Odświeżanie strony po zmianie treści w panelu (ADR 0065): API woła POST na Route Handler strony z sekretem
# w nagłówku Authorization (Bearer). Pusty adres wyłącza wywołanie (strona odświeża się sama po 5 min).
# Na komputerze autora strona działa na WEB_PORT=3002: http://localhost:3002/api/revalidate
SITE_REVALIDATE_URL=
# Wspólny sekret API i strony, co najmniej 32 znaki: openssl rand -base64 32
SITE_REVALIDATE_SECRET=
# Strona (apps/web, ADR 0065): adres API z serwera strony (puste = NEXT_PUBLIC_API_URL) i odnośnik
# „Mam aplikację, otwórz hulajnogę” na /h/{numer} ({numer} = cztery cyfry; dev z aplikacją web:
# http://localhost:8082/hulajnoga/{numer})
API_INTERNAL_URL=
APP_SCOOTER_LINK=hulajnogi://hulajnoga/{numer}
# Powiadomienia push (ADR 0058): fake (domyślnie; zapis SENT i treść w logu API, wersja web pokazuje baner
# przez Socket.IO) albo expo (Expo Push API; wymaga projektu EAS, poświadczeń FCM/APNs i development build).
PUSH_PROVIDER=fake
# Token dostępu Expo (opcjonalny; tylko przy włączonym „Enhanced Security for Push Notifications” w projekcie EAS).
EXPO_ACCESS_TOKEN=
# Sterowanie symulatorem z panelu przez MQTT simulator/control (ADR 0059). Puste = true przy NODE_ENV=development,
# false w pozostałych; przy false punkty /admin/simulator/* zwracają 404.
SIMULATOR_CONTROL_ENABLED=

# Symulator floty (ADR 0034)
SIM_FLEET_SIZE=40
SIM_TELEMETRY_INTERVAL_MS=5000
# Przejazdy pokazowe domyślnie wyłączone: hulajnogi ruszają po odblokowaniu przez klienta (ADR 0039)
SIM_RIDES_PER_HOUR=0
# Strefy dla wirtualnego klienta symulatora z GET /zones (ADR 0046); bez API plik miejsc.
SIM_API_URL=http://localhost:3001

# Dane startowe
SEED_ADMIN_EMAIL=admin@hulajnogi.local
SEED_ADMIN_PASSWORD=zmien-mnie
SEED_FLEET_SIZE=40
# Przykładowe zakończone przejazdy (lista w panelu, historia w aplikacji)
SEED_SAMPLE_RENTALS=12
