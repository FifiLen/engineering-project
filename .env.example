# Baza danych (Docker Compose z infra/). Gdy port 5432 jest zajęty, zmień oba wpisy, np. na 5433.
POSTGRES_PORT=5432
DATABASE_URL=postgres://hulajnogi:hulajnogi@localhost:5432/hulajnogi

# Broker MQTT
MQTT_URL=mqtt://localhost:1883

# Magazyn plików SeaweedFS (API S3, ADR 0024)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=hulajnogi
S3_SECRET_KEY=hulajnogi-dev-secret
S3_BUCKET=hulajnogi

# OSRM. Na macOS port 5000 zajmuje Odbiornik AirPlay: zmień oba wpisy, np. na 5001.
OSRM_PORT=5000
OSRM_URL=http://localhost:5000

# Backend
API_PORT=3001

# Dane startowe
SEED_ADMIN_EMAIL=admin@hulajnogi.local
SEED_ADMIN_PASSWORD=zmien-mnie
SEED_FLEET_SIZE=40
