{
  "expo": {
    "name": "Hulajnogi",
    "slug": "hulajnogi",
    "owner": "fifi3303",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hulajnogi",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B3FF5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B3FF5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": [],
          "enableGooglePay": false,
          "disableSPM": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zdjęcie z galerii dołączysz do zgłoszenia albo jako zdjęcie parkowania.",
          "cameraPermission": "Aparat służy do skanowania kodu QR i zdjęć hulajnogi."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2B3FF5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e64c7409-1996-4129-a210-874d7d9ad943"
      }
    }
  }
}
