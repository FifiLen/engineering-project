{
  "name": "hulajnogi",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @hulajnogi/db run migrate",
    "db:seed": "pnpm --filter @hulajnogi/db run seed",
    "db:places": "pnpm --filter @hulajnogi/db run places",
    "db:pull": "pnpm --filter @hulajnogi/db run pull",
    "db:staff:create": "pnpm --filter @hulajnogi/db run staff:create",
    "db:history": "pnpm --filter @hulajnogi/db run history",
    "api:openapi": "pnpm --filter @hulajnogi/api run openapi"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
